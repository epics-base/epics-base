#*************************************************************************
# Default definitions for all linux-fsl-powerpc64 targets
#*************************************************************************

# ---------------------------------------------------------------------
# NOTE: This build targets generic 64-bit PowerPC (powerpc64) architecture
#       - Compatible with Freescale/NXP platforms and most ppc64 CPUs
#       - Default: build system (toolchain) configuration
#       - Suitable for portable binaries and maximum compatibility
# ---------------------------------------------------------------------

include $(CONFIG)/os/CONFIG.Common.linux-ppc64
include $(CONFIG)/os/CONFIG.yoctoCommon.Common

GNU_TARGET = powerpc64-fsl-linux
OECORE_SYSROOT ?= /opt/ifc14xx/default/sysroots
OECORE_NATIVE_SYSROOT ?= $(OECORE_SYSROOT)/x86_64-fslsdk-linux
# Select target sysroot
OECORE_TARGET_SYSROOT ?= $(OECORE_SYSROOT)/ppc64e6500-fsl-linux

# Add site specific configuration
-include $(CONFIG)/os/CONFIG_SITE.yoctoCommon.linux-fsl-powerpc64
