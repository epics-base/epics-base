#*************************************************************************
# Default definitions for all linux-poky-x86_64 targets
#*************************************************************************

# ---------------------------------------------------------------------
# NOTE: This build targets a generic 64-bit x86 architecture (x86_64)
#       - Compatible with most modern Intel and AMD CPUs (Core 2 Duo or newer)
#       - Default: build system (toolchain) configuration
#       - Suitable for portable binaries and maximum compatibility
# ---------------------------------------------------------------------

include $(CONFIG)/os/CONFIG.Common.linux-x86_64
include $(CONFIG)/os/CONFIG.yoctoCommon.Common

GNU_TARGET = x86_64-poky-linux
OECORE_SYSROOT ?= /opt/cct/default/sysroots
OECORE_NATIVE_SYSROOT ?= $(OECORE_SYSROOT)/x86_64-pokysdk-linux
# Select target sysroot
OECORE_TARGET_SYSROOT ?= $(OECORE_SYSROOT)/corei7-64-poky-linux

# [OPTIONAL] Use ld.gold instead of ld
## ARCH_DEP_LDFLAGS += -Wl,-fuse-ld=gold
## ARCH_DEP_LDFLAGS += -Wl,--icf=all

# Add site specific configuration
-include $(CONFIG)/os/CONFIG_SITE.yoctoCommon.linux-poky-x86_64
