# Definitions for the linux-poky-corei7_64-avx2 target builds
# Override these settings in CONFIG_SITE

# Include dependency
include $(CONFIG)/os/CONFIG.Common.linux-poky-x86_64

OECORE_TARGET_SYSROOT = $(OECORE_SYSROOT)/corei7-64-poky-linux

# Targets the Haswell (4th Gen or later) Intel i7 processors with avx2 (Advanced Vector Extensions) support.
ARCH_DEP_CPPFLAGS += -march=core-avx2 -mtune=core-avx2 -O3 -mavx2 -mfma -funroll-loops -ffast-math -falign-functions=32 -fopenmp

# [OPTIONAL] Link Time Optimization
ARCH_DEP_CPPFLAGS += -flto
ARCH_DEP_LDFLAGS += -Wl,-flto
