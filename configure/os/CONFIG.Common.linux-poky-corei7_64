# Definitions for the linux-poky-corei7_64 target builds
# Override these settings in CONFIG_SITE

# Include dependency
include $(CONFIG)/os/CONFIG.yoctoCommon.linux-poky-x86_64

OECORE_TARGET_SYSROOT = $(OECORE_SYSROOT)/corei7-64-poky-linux

ARCH_DEP_CPPFLAGS += -mtune=generic
# -mfpmath=sse : enables use of XMM registers in floating point instructions (instead of stack in x87 mode)
ARCH_DEP_CPPFLAGS += -mfpmath=sse

# -msse4.2
# Intel Streaming SIMD Extensions 4 (SSE4) introduces 54 new instructions
# in Intel 64 processors made from 45 nm process technology.
# The next generation 45nm processors is Nehalem
ARCH_DEP_CPPFLAGS += -march=nehalem -msse4.2
